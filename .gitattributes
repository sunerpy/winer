# Captured fixtures are compared byte for byte by the tests that read them.
fixtures/** text eol=lf

# The LCU's root certificate is compiled in with include_bytes!.
*.pem text eol=lf

# Generated by ts-rs and compared byte for byte with the generator's output by the drift test, which
# also runs on Windows, where a checkout would otherwise turn it CRLF.
packages/shared/src/bindings.ts text eol=lf

# Raw tray pixels, read with include_bytes!.
*.rgba binary
